(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
      (string=? candidate "ethics") 4
      (string=? candidate "finance") 4
      (string=? candidate "governance") 22
      (string=? candidate "membership") 7
      :else 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (cond
      (string=? candidate "ethics") (cond
        (= i 0) (entry-field a 26 "id")
        (= i 1) (entry-field a 27 "id")
        (= i 2) (entry-field a 28 "id")
        (= i 3) (entry-field a 29 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "finance") (cond
        (= i 0) (entry-field a 18 "id")
        (= i 1) (entry-field a 19 "id")
        (= i 2) (entry-field a 21 "id")
        (= i 3) (entry-field a 25 "id")
        :else (option-none-of [:option :string]))
      (string=? candidate "governance") (cond
