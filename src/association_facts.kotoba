;; The CIU source catalog, as Kotoba.
;;
;; GENERATED from data/datascript-tx.edn, which src/association/facts.cljc
;; reads as data. Both are the same catalog; this one reaches the Kotoba
;; oracle, wasm and both native ISAs, which the .cljc cannot.
;;
;; `:topic` is a SET in the source. A set has no order and `topic` is
;; indexed by position, so the generator uses the order the data file
;; writes. `by-topic-id` answers by name and is unaffected.
;;
;; Parity: test/association_facts_kotoba_parity_test.clj compares every
;; field of every entry against the .cljc, so this file cannot drift from
;; the data without the suite saying so.

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool (string=? a "ciu"))

(defn entry-count [a :string] :i64 (if (association-covered? a) 1 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (< i 0) false (< i 1)) false))

(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (cond
      (string=? f "id") (option-some-of [:option :string] "ciu.founding-1898-11-12")
      (string=? f "title") (option-some-of [:option :string] "Cámara de Industrias del Uruguay (CIU) founded 12 November 1898 (ciu.com.uy's own official page, independently corroborated by the Uruguayan Parliament's own library catalog pmb.parlamento.gub.uy)")
      (string=? f "association") (option-some-of [:option :string] "ciu")
      (string=? f "isic") (option-some-of [:option :string] "9411")
      (string=? f "country") (option-some-of [:option :string] "URY")
      (string=? f "kind") (option-some-of [:option :string] "governance-program")
      (string=? f "url") (option-some-of [:option :string] "https://www.ciu.com.uy/propuesta-de-valor/que-es-la-ciu/")
      (string=? f "url-provenance") (option-some-of [:option :string] "official-ciu-com-uy")
      (string=? f "established-date") (option-some-of [:option :string] "1898-11-12")
      (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-18")
      :else (option-none-of [:option :string])
      )
    (option-none-of [:option :string])))

(defn topic-count [a :string i :i64] :i64
  (if (valid-entry? a i)
    (if (= i 0) 1 0)
    0))

(defn topic [a :string i :i64 t :i64] [:option :string]
  (if (valid-entry? a i)
    (if (= i 0)
      (if (= t 0) (option-some-of [:option :string] "governance") (option-none-of [:option :string]))
    (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (if (string=? candidate "governance") 1 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (if (= i 0)
      (if (string=? candidate "governance") (entry-field a 0 "id") (option-none-of [:option :string]))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string]
      "cloud-itonami-assoc-9411-ury-ciu Wave 0 (ADR-2607141700): 1 ciu entries seeded with an official citation. Extend the sovereign catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)
